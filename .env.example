# ============================================
# Meet Transcribe - Environment Configuration
# ============================================
#
# BACKEND OPTIONS:
# - Python Backend (FastAPI): Use this file in root directory
# - Node.js Backend (NestJS): Use backend-node/.env.example
#
# Quick Start:
# - Python: cp .env.example .env
# - Node.js: cp backend-node/.env.example backend-node/.env
# ============================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./meet_transcribe.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Transcription Provider Configuration
# Options: local (PhoWhisper), openai, assemblyai
TRANSCRIPTION_PROVIDER=local

# API Keys for Transcription Providers (if using API-based transcription)
OPENAI_API_KEY=your-openai-api-key-here
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# AI Services (Optional - for meeting minutes generation)
ANTHROPIC_API_KEY=your-anthropic-api-key

# PhoWhisper Model Configuration (for local transcription)
# Models: vinai/PhoWhisper-tiny, small, base, medium, large
WHISPER_MODEL=vinai/PhoWhisper-small
DEVICE=cpu
TRANSCRIPTION_LANGUAGE=vi

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
